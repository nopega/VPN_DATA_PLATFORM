        </mxCell>
        <mxCell id="e_pod_sts" edge="1" parent="1" source="ec2_sp_b" style="endArrow=classic;html=1;dashed=1;strokeColor=#DD344C;strokeWidth=2;fontSize=10;fontColor=#DD344C;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.737;entryY=1;entryDx=0;entryDy=0;edgeStyle=none;" target="iam_card" value="Pod Identity agent &amp;#8594; role credentials">
