        </mxCell>
        <mxCell id="e_vpce_s3" edge="1" parent="1" source="vpce_card" style="endArrow=classic;html=1;strokeColor=#00A4A6;strokeWidth=2;fontSize=10;fontColor=#00857A;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=none;" target="s3_card" value="S3 API &amp;#8212; stays on the AWS private network">
          <mxGeometry relative="1" as="geometry">
            </mxGeometry>
        </mxCell>
        <mxCell id="fn" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6C7D;" value="&lt;b&gt;Subnets come from Terraform cidrsubnet().&lt;/b&gt; Two public /24s hold only the router and the internet-gateway route; two private /19s hold the nodes, every pod (VPC CNI prefix delegation, up to 110 pods a node) and the internal ALB.&lt;br&gt;&lt;b&gt;The only thing listening on a public address is the router&amp;#8217;s Tailscale port.&lt;/b&gt; The ALB, the EKS API and RDS have private addresses only; users, kubectl and the BI tools all arrive through the tailnet." vertex="1">
          <mxGeometry height="70" width="1940" x="40" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="e_acm_alb" edge="1" parent="1" source="acm_card" style="endArrow=classic;html=1;dashed=1;strokeColor=#DD344C;fontSize=10;fontColor=#DD344C;rounded=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=none;" target="alb_b" value="certificate attached to the ALB">
          <mxGeometry relative="1" x="-0.0011" as="geometry">
            </mxGeometry>
        </mxCell>
        <mxCell id="e_eks_oidc" edge="1" parent="1" source="eks_cp_card" style="endArrow=classic;html=1;dashed=1;strokeColor=#DD344C;fontSize=10;fontColor=#DD344C;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=none;" target="iam_card" value="Pod Identity&lt;br&gt;&amp;nbsp;associations">
