        <mxCell id="e_git" edge="1" parent="1" source="ext_github" style="endArrow=classic;html=1;dashed=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=10;fontColor=#8C4FFF;rounded=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=none;" target="ec2_od_a" value="Argo CD and CI runners pull from git &amp;#8212; outbound only">
