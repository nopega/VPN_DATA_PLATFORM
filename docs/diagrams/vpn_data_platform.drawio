          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nat_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=48;" value="&lt;b&gt;Tailscale router + NAT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;t4g.nano &amp;#183; Elastic IP &amp;#183; ~$8.50/mo&lt;br&gt;advertises 10.42.0.0/16 &amp;#183; only UDP 41641 open&lt;/span&gt;" vertex="1">
          <mxGeometry height="88" width="265" x="420" y="620" as="geometry" />
