        </mxCell>
        <mxCell id="c_tc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=2;" value="&lt;b&gt;Trino coordinator &amp;#215; 1&lt;/b&gt; &amp;#8212; 480&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;password file (bcrypt) &amp;#8594; file access rules&lt;br&gt;&lt;b&gt;the only door to the data&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="390" x="795" y="410" as="geometry" />
        </mxCell>
        <mxCell id="c_tw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=2;" value="&lt;b&gt;Trino workers &amp;#215; 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;autoscaling off for now &amp;#8212; the chart&amp;#8217;s HPA is one value away&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="390" x="795" y="560" as="geometry" />
        </mxCell>
        <mxCell id="c_pol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=3;fillColor=#EFF6FF;" value="&lt;b&gt;Apache Polaris 1.5.0&lt;/b&gt; — Iceberg REST catalog&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;RBAC · atomic commits · &lt;b&gt;credential vending&lt;/b&gt;&lt;br&gt;holds no data — hands each engine short-lived, scoped S3 credentials&lt;/span&gt;" vertex="1">
