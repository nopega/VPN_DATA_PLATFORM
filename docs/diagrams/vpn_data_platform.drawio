  <diagram id="data-platform" name="Data Platform">
    <mxGraphModel dx="1147" dy="778" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
