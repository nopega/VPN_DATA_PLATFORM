        </mxCell>
        <mxCell id="ns_so" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#879196;fillColor=#FBFBFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#5A6C7D;" value="namespace: spark-operator" vertex="1">
