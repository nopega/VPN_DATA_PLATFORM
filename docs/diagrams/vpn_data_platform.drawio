        <mxCell id="c_drv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#ED7100;strokeWidth=2;" value="&lt;b&gt;Spark driver&lt;/b&gt; &amp;#8212; 4.0.1 + Iceberg 1.11.0&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;on-demand (workload=critical)&lt;br&gt;downloads its own code from GitHub at start&lt;br&gt;&lt;b&gt;bronze &amp;#8594; silver &amp;#8594; gold&lt;/b&gt;, one day per run&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="285" y="790" as="geometry" />
        </mxCell>
        <mxCell id="c_exe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#879196;strokeWidth=2;dashed=1;" value="&lt;b&gt;Spark executors &amp;#215; 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;on Karpenter Spot, &lt;b&gt;0 &amp;#8594; N &amp;#8594; 0&lt;/b&gt;&lt;br&gt;node removed a minute after the job&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="285" y="925" as="geometry" />
