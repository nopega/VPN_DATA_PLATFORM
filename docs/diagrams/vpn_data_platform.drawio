        <mxCell id="c_prom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#879196;strokeWidth=2;" value="&lt;b&gt;Prometheus 3.13.2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;scrapes every namespace&lt;br&gt;7 d / 18 GiB on a 20 GiB PVC&lt;br&gt;single replica — RWO volume&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="1315" y="795" as="geometry" />
        </mxCell>
        <mxCell id="c_graf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#879196;strokeWidth=2;" value="&lt;b&gt;Grafana 13.1.3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;dashboards over Prometheus&lt;/span&gt;&lt;br&gt;&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;evaluating rules; &lt;b&gt;no receiver yet&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="1585" y="795" as="geometry" />
        </mxCell>
        <mxCell id="ns_cd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#879196;fillColor=#FBFBFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#5A6C7D;" value="namespace: argocd" vertex="1">
