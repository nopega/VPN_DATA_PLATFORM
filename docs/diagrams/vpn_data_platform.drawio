        <mxCell id="c_so" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#ED7100;strokeWidth=2;" value="&lt;b&gt;Spark Operator 2.5.0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;watches the CRD, creates the driver pod&lt;/span&gt;" vertex="1">
