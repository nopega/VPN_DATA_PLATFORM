<diagram id="data-flow" name="Data Flow"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1960" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t3" value="&lt;b style=&quot;font-size: 26px;&quot;&gt;Data flow &amp;#8212; from source to dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #5A6C7D; font-size: 13px;&quot;&gt;medallion architecture on Apache Iceberg &amp;#183; orchestrated by Airflow, processed by Spark, served by Trino &amp;#183; one partition per run, re-runnable: each step replaces its partition&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=26;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry" /></mxCell><mxCell id="af" value="&lt;b&gt;Airflow&lt;/b&gt; &amp;#8212; one DAG per pipeline, on a schedule&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;ingest &amp;#187; clean &amp;#187; aggregate &amp;#183; each task submits one Spark job and waits for it &amp;#183; retries, alerts, and the job&amp;#8217;s output in the task log (kept in S3)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;strokeWidth=2;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="1120" height="80" as="geometry" /></mxCell><mxCell id="af_logo" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn.simpleicons.org/apacheairflow;" vertex="1" parent="1"><mxGeometry x="394" y="128" width="44" height="44" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;files (Parquet, CSV, JSON)&lt;br&gt;APIs &amp;#183; database exports&lt;br&gt;reference / lookup data&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;arcSize=8;strokeWidth=2;strokeColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="260" height="120" as="geometry" /></mxCell><mxCell id="job_bronze" value="&lt;b&gt;Spark &amp;#183; ingest &amp;#8594; bronze&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;pulls one partition from the source&lt;br&gt;lands it &lt;b&gt;unchanged&lt;/b&gt; + ingested_at, run_id&lt;br&gt;the replayable copy of the source&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;strokeWidth=2;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="320" height="120" as="geometry" /></mxCell><mxCell id="job_bronze_logo" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn.simpleicons.org/apachespark;" vertex="1" parent="1"><mxGeometry x="392" y="318" width="44" height="44" as="geometry" /></mxCell><mxCell id="job_silver" value="&lt;b&gt;Spark &amp;#183; clean &amp;#8594; silver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;&lt;b&gt;quality rules&lt;/b&gt;, every failure &lt;b&gt;counted&lt;/b&gt;&lt;br&gt;de-duplicated &amp;#183; typed &amp;#183; renamed&lt;br&gt;derived columns per record&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;strokeWidth=2;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="780" y="280" width="320" height="120" as="geometry" /></mxCell><mxCell id="job_silver_logo" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn.simpleicons.org/apachespark;" vertex="1" parent="1"><mxGeometry x="792" y="318" width="44" height="44" as="geometry" /></mxCell><mxCell id="job_gold" value="&lt;b&gt;Spark &amp;#183; aggregate &amp;#8594; gold&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;business-level aggregates&lt;br&gt;lookups joined in, names not ids&lt;br&gt;ratios computed from totals, not averaged&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;strokeWidth=2;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1180" y="280" width="320" height="120" as="geometry" /></mxCell><mxCell id="job_gold_logo" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn.simpleicons.org/apachespark;" vertex="1" parent="1"><mxGeometry x="1192" y="318" width="44" height="44" as="geometry" /></mxCell><mxCell id="lake" value="&lt;b&gt;S3 warehouse &amp;#183; Apache Iceberg tables&lt;/b&gt; &amp;#8212; catalog &lt;b&gt;data_platform&lt;/b&gt; in Polaris &amp;#183; partitioned by date" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#879196;fillColor=#FBFBFB;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#5A6C7D;arcSize=4;" vertex="1" parent="1"><mxGeometry x="360" y="470" width="1160" height="230" as="geometry" /></mxCell><mxCell id="tbl_bronze" value="&lt;b&gt;bronze.&amp;lt;domain&amp;gt;.&amp;lt;table&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;raw, as the source sent it&lt;br&gt;append-only history&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3EC;strokeColor=#B87333;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="530" width="320" height="120" as="geometry" /></mxCell><mxCell id="tbl_bronze_logo" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="392" y="566" width="44" height="44" as="geometry" /></mxCell><mxCell id="tbl_silver" value="&lt;b&gt;silver.&amp;lt;domain&amp;gt;.&amp;lt;table&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;only rows that passed every rule&lt;br&gt;safe to query record by record&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8E9AA6;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="530" width="320" height="120" as="geometry" /></mxCell><mxCell id="tbl_silver_logo" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="792" y="566" width="44" height="44" as="geometry" /></mxCell><mxCell id="tbl_gold" value="&lt;b&gt;gold.&amp;lt;domain&amp;gt;.&amp;lt;table&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;small, pre-aggregated, pre-joined&lt;br&gt;shaped for the dashboard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF6E3;strokeColor=#C9A227;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="530" width="320" height="120" as="geometry" /></mxCell><mxCell id="tbl_gold_logo" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1192" y="566" width="44" height="44" as="geometry" /></mxCell><mxCell id="pol" value="&lt;b&gt;Apache Polaris&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;every read and write goes through it&lt;br&gt;vends short-lived S3 credentials per table&lt;br&gt;principal &lt;b&gt;etl&lt;/b&gt; writes &amp;#183; Trino reads&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;strokeWidth=2;strokeColor=#2E73B8;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="260" height="120" as="geometry" /></mxCell><mxCell id="pol_logo" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn.simpleicons.org/apache;" vertex="1" parent="1"><mxGeometry x="52" y="568" width="44" height="44" as="geometry" /></mxCell><mxCell id="trino" value="&lt;b&gt;Trino&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;SQL over any layer&lt;br&gt;password login &amp;#183; access rules&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;arcSize=8;strokeWidth=2;strokeColor=#2E73B8;" vertex="1" parent="1"><mxGeometry x="1620" y="530" width="280" height="120" as="geometry" /></mxCell><mxCell id="trino_logo" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn.simpleicons.org/trino;" vertex="1" parent="1"><mxGeometry x="1632" y="568" width="44" height="44" as="geometry" /></mxCell><mxCell id="bi" value="&lt;b&gt;Dashboards &amp;#183; BI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;Power BI, Superset, notebooks&amp;#8230;&lt;br&gt;read gold through Trino&lt;br&gt;small tables load once, clicks stay fast&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;arcSize=8;strokeWidth=2;strokeColor=#2E73B8;" vertex="1" parent="1"><mxGeometry x="1620" y="780" width="280" height="120" as="geometry" /></mxCell><mxCell id="fn3" value="&lt;b&gt;Medallion, in one line each:&lt;/b&gt; &lt;b&gt;bronze&lt;/b&gt; is the source as it arrived, so any later step can be replayed without downloading again; &lt;b&gt;silver&lt;/b&gt; is the same records after the rules, with every rejected row counted rather than silently dropped; &lt;b&gt;gold&lt;/b&gt; is the business answer, pre-aggregated and pre-joined for the people who read it.&lt;br&gt;&lt;b&gt;Re-runs are safe:&lt;/b&gt; every step replaces its own partition &amp;#8212; an Airflow retry after a half-finished write cannot double a number." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1860" height="60" as="geometry" /></mxCell><mxCell id="f_src" value="extract" style="endArrow=classic;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=10;fontColor=#ED7100;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="job_bronze"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_af_bronze" value="submits" style="endArrow=classic;html=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#ED7100;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.1429;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="job_bronze"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_w_bronze" value="writes" style="endArrow=classic;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=10;fontColor=#ED7100;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="job_bronze" target="tbl_bronze"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_af_silver" value="submits" style="endArrow=classic;html=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#ED7100;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="job_silver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_w_silver" value="writes" style="endArrow=classic;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=10;fontColor=#ED7100;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="job_silver" target="tbl_silver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_af_gold" value="submits" style="endArrow=classic;html=1;strokeColor=#ED7100;strokeWidth=1.5;fontSize=10;fontColor=#ED7100;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.8571;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="job_gold"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_w_gold" value="writes" style="endArrow=classic;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=10;fontColor=#ED7100;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="job_gold" target="tbl_gold"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_r_b" value="reads the partition" style="endArrow=classic;html=1;strokeColor=#2E73B8;strokeWidth=2;fontSize=10;fontColor=#2E73B8;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_bronze" target="job_silver"><mxGeometry relative="1" as="geometry" x="0.55"><Array as="points"><mxPoint x="740" y="566" /><mxPoint x="740" y="364" /></Array></mxGeometry></mxCell><mxCell id="f_r_s" value="reads the partition" style="endArrow=classic;html=1;strokeColor=#2E73B8;strokeWidth=2;fontSize=10;fontColor=#2E73B8;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_silver" target="job_gold"><mxGeometry relative="1" as="geometry" x="0.55"><Array as="points"><mxPoint x="1140" y="566" /><mxPoint x="1140" y="364" /></Array></mxGeometry></mxCell><mxCell id="f_pol" value="credentials" style="endArrow=classic;html=1;strokeColor=#2E73B8;strokeWidth=1.5;fontSize=10;fontColor=#2E73B8;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pol" target="tbl_bronze"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_q" value="SQL" style="endArrow=classic;html=1;strokeColor=#2E73B8;strokeWidth=2;fontSize=10;fontColor=#2E73B8;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_gold" target="trino"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f_bi" value="JDBC / ODBC over Tailscale" style="endArrow=classic;html=1;strokeColor=#2E73B8;strokeWidth=2;fontSize=10;fontColor=#2E73B8;rounded=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="trino" target="bi"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>