        <mxCell id="c_cd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#8C4FFF;strokeWidth=2;" value="&lt;b&gt;Argo CD&lt;/b&gt; &amp;#8212; app-of-apps&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;root is created by Terraform; every app is reconciled from git in sync waves &amp;#8212; nothing is applied by hand&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="520" x="1315" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="c_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#7AA116;strokeWidth=2;fillColor=#F2F6E8;" value="&lt;b&gt;s3://…-warehouse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;Iceberg metadata + Parquet · partitioned on trip_date · via the gateway endpoint, $0 transfer&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="440" x="770" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="c_rds" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=2;" value="&lt;b&gt;RDS PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;iceberg_catalog &amp;#8212; Polaris, every table pointer&lt;br&gt;airflow &amp;#8212; scheduler metadata&lt;br&gt;registry &amp;#8212; Harbor&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="430" x="260" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="fn2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C7D;" value="&lt;b&gt;Read path&lt;/b&gt; (blue): user &amp;#8594; Tailscale &amp;#8594; internal ALB &amp;#8594; Trino &amp;#8594; Polaris &amp;#8594; S3 on vended credentials. &lt;b&gt;Write path&lt;/b&gt; (orange): Airflow asks, the operator creates, the driver writes &amp;#8212; through the same catalog, as Polaris principal &lt;i&gt;etl&lt;/i&gt;. The two paths meet nowhere else, which is what makes Polaris the single place access control lives.&lt;br&gt;&lt;b&gt;Build path&lt;/b&gt; (brown): a git tag queues a job; runners inside the cluster pull it, build on a real x86 node and push to Harbor. GitHub never connects in &amp;#8212; nothing on this page has a public address." vertex="1">
          <mxGeometry height="80" width="1880" x="40" y="1610" as="geometry" />
        </mxCell>
