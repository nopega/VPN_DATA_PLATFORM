        <mxCell id="t2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontColor=#232F3E;" value="&lt;b style=&quot;font-size: 26px;&quot;&gt;Data Platform &amp;#8212; the Kubernetes layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #5A6C7D; font-size: 13px;&quot;&gt;what runs ON the infrastructure page: one catalog, a write path (Spark) and a read path (Trino) that only meet at Polaris &amp;#8212; all of it GitOps&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1400" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="x_users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;strokeColor=#5A6C7D;align=left;spacingLeft=64;" value="&lt;b&gt;Users &amp;#183; BI clients &amp;#8212; over Tailscale&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;Power BI &amp;#183; DBeaver &amp;#183; JDBC&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="340" x="820" y="100" as="geometry" />
        </mxCell>
