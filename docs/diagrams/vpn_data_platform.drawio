          <mxGeometry height="60" width="300" x="340" y="100" as="geometry" />
        </mxCell>
        <mxCell id="alb2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#8C4FFF;strokeWidth=2;" value="&lt;b&gt;Internal ALB&lt;/b&gt; &amp;#8212; trino &amp;#183; airflow &amp;#183; harbor &amp;#183; grafana &amp;#183; argocd &amp;#183; prometheus&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;wildcard TLS ends here &amp;#183; accepts 10.42.0.0/16 only&lt;/span&gt;" vertex="1">
